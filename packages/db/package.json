{
  "name": "@Alpha/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated/client": {
      "types": "./prisma/generated/client/index.d.ts",
      "default": "./prisma/generated/client/index.js"
    },
    "./prisma/generated/client": {
      "types": "./prisma/generated/client/index.d.ts",
      "default": "./prisma/generated/client/index.js"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
