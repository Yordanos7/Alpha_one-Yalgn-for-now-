    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsdown": "^0.15.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
